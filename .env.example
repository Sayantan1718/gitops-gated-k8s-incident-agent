# Gemini API (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Kubernetes — path to the READ-ONLY kubeconfig generated by
# infra/generate-agent-kubeconfig.sh. Never point this at your default
# ~/.kube/config, which has admin rights.
KUBECONFIG_PATH=./configs/rbac/agent-kubeconfig.yaml

# GitHub (Phase 7 — PR creation)
GIT_PROVIDER=github
GIT_TOKEN=
GIT_REPO=your-org/your-gitops-repo
GIT_BASE_BRANCH=main
